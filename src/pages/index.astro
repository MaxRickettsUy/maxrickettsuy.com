---
import Layout from "@layouts/Layout.astro";
import Carousel from "@components/Carousel.astro";
import SocialIcon from "@components/SocialIcon.astro";

const socials = [
  { href: "https://www.github.com/MaxRickettsUy", title: "GitHub", icon: "simple-icons:github" },
  { href: "https://www.linkedin.com/in/max-ricketts-uy", title: "LinkedIn", icon: "simple-icons:linkedin" },
  { href: "https://m19y.dev", title: "m19y.dev", icon: "simple-icons:astro" },
  { href: "mailto:mrickettsuy@protonmail.com", title: "Email", icon: "lucide:mail", external: false },
];
---

<Layout>
  <div class="flex justify-center flex-col items-center h-screen gap-4">
    <div class="flex flex-row">
      <h1 class="text-3xl text-red-500 font-bold">
        hi, i'm max!
      </h1>
    </div>
    <Carousel />
    <div class="text-center">
      <p>Scroll to view more photos! 😀</p>
      <p>Check out the links below for more about me.</p>
    </div>
    <div class="flex flex-row mt-4 gap-5">
      {socials.map((s) => <SocialIcon {...s} />)}
    </div>
  </div>
</Layout>
